{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Engine packages are pure simulation logic: no DOM, no React, no Three.js.
    "lib": ["ES2022"],
    "types": [],
    // Node runs these files directly (API): erasable TypeScript only.
    "erasableSyntaxOnly": true
  },
  "include": ["packages/*/src/**/*.ts"]
}
