# OneRoboLab API — copy to .env for local development. Never commit .env.
# On Render these are set in the dashboard (see render.yaml).

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Neon (or any PostgreSQL 15+) connection string. Use the pooled endpoint and keep sslmode=require.
# Example shape only — use your own values:
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_POOL_MAX=10

# HMAC key for session tokens: at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Allowed browser origins, comma-separated (the web app's URL).
CORS_ORIGIN=http://localhost:5173

SESSION_TTL_HOURS=168
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MINUTES=15
LOG_LEVEL=info
