# OneRoboLab web app — copy to .env.local if needed. Never put secrets here:
# every VITE_* value is compiled into the public JavaScript bundle.

# Origin of the OneRoboLab API used by the admin console (/admin).
# Leave empty in development: Vite proxies /api and /health to http://127.0.0.1:3000
# (override the target with ONEROBOLAB_API_PROXY when starting `pnpm dev`).
# Production example: VITE_API_URL=https://onerobolab-api.onrender.com
VITE_API_URL=
